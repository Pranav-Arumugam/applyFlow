{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "controllers/**/*",
    "errors/**/*",
    "middleware/**/*",
    "models/**/*",
    "routes/**/*",
    "utils/**/*",
    "types/**/*"
  ],
  "exclude": ["node_modules", "dist", "client", "public"]
}
